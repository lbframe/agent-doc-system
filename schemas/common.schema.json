{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentdoc.dev/schema/common.json",
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S"
    },
    "entityRef": {
      "type": "string",
      "pattern": "^(domain|system|component|api|resource):[a-z0-9][a-z0-9-]*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "componentRef": { "$ref": "#/$defs/entityRef" },
    "apiRef": { "$ref": "#/$defs/entityRef" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\s\\\\][^\\s]*$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 40
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "normativeCitation": {
      "description": "One section of a configured normative document, pinned by the digest it had when it was reviewed. `agentdoc audit` lists every section with its current digest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "section": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "requirementKey": { "type": "string", "maxLength": 80, "pattern": "^requirement\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "requirementValue": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "requirement": {
      "description": "An implementation obligation a normative document places on this component. It is an AUTHORED fact that must be corroborated by implementation evidence on the same key; it never stands on its own word.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "value", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "key": { "$ref": "#/$defs/requirementKey" },
        "value": { "$ref": "#/$defs/requirementValue" },
        "source": { "$ref": "#/$defs/normativeCitation" },
        "satisfiedBy": {
          "description": "Adapters able to derive the implementation side of this requirement. Named so a missing extractor is reported as such instead of as silence.",
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "expects": {
          "description": "What an adapter in satisfiedBy must find for the requirement to be provided: a host path installed, or a service managed. Without it an adapter has nothing deterministic to compare.",
          "type": "object",
          "additionalProperties": false,
          "oneOf": [{ "required": ["installs"] }, { "required": ["service"] }],
          "properties": {
            "installs": { "type": "string", "maxLength": 400, "pattern": "^/[^\\s{}]*[^\\s{}/]$" },
            "service": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9@._-]+$" }
          }
        }
      }
    },
    "warningAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subject", "classification", "reason", "reviewWhen", "observedRefs", "evidence"],
      "properties": {
        "code": { "type": "string", "pattern": "^AGENTDOC_[A-Z_]+$" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^\\S+$" },
        "classification": { "type": "string", "pattern": "^[A-Z]+(?:_[A-Z]+)*$" },
        "reason": { "$ref": "#/$defs/rationale" },
        "reviewWhen": { "$ref": "#/$defs/rationale" },
        "observedRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/entityRef" } },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docs": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "constraints": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "runbooks": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Forward-evolution escape hatch. Core validators ignore these keys.",
      "additionalProperties": true
    }
  }
}
