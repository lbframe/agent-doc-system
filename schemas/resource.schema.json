{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentdoc.dev/schema/resource.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentdoc.dev/v1" },
    "kind": { "const": "Resource" },
    "metadata": { "$ref": "common.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["logical-database", "logical-dataset", "event-bus", "queue", "cache", "object-store", "search-index", "secret-store", "other"] },
        "placementRationale": { "$ref": "common.json#/$defs/rationale" },
        "system": { "$ref": "common.json#/$defs/name" },
        "context": { "$ref": "common.json#/$defs/context" },
        "migrationPaths": {
          "description": "Repository directories (or files) holding this logical database's schema migrations, matched as whole-segment path prefixes. Authoritative for change impact: a change under one of them is a change to this Resource, whichever component owns the file. Never a binding: which components use the database is still derived. Only a logical-database may declare them.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "common.json#/$defs/repoPath" }
        }
      },
      "oneOf": [
        { "required": ["system"] },
        { "required": ["placementRationale"] }
      ]
    },
    "extensions": { "$ref": "common.json#/$defs/extensions" }
  }
}
