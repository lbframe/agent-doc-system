{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentdoc.dev/schema/domain.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": { "const": "agentdoc.dev/v1" },
    "kind": { "const": "Domain" },
    "metadata": { "$ref": "common.json#/$defs/metadata" },
    "spec": { "type": "object", "additionalProperties": false, "properties": {} },
    "extensions": { "$ref": "common.json#/$defs/extensions" }
  }
}
